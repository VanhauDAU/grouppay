{
  "name": "tinhtien-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Website quản lý chi tiêu và công nợ nhóm",
  "scripts": {
    "dev:frontend": "pnpm --filter @tinhtien/frontend dev",
    "dev:backend": "pnpm --filter @tinhtien/backend dev",
    "build:shared": "pnpm --filter @tinhtien/shared build",
    "build:frontend": "pnpm --filter @tinhtien/frontend build",
    "build:backend": "pnpm --filter @tinhtien/backend build",
    "build": "pnpm build:shared && pnpm build:frontend && pnpm build:backend",
    "test": "pnpm --filter @tinhtien/shared test"
  },
  "onlyBuiltDependencies": [
    "esbuild",
    "@swc/core",
    "workerd"
  ],
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
